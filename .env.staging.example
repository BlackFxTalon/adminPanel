# Staging environment (names only — never commit real values).
# Copy to .env.staging on the VDS and fill in.

# Supabase PostgreSQL connection string (staging database).
DATABASE_URL=

# JWT signing secret, at least 32 characters.
AUTH_JWT_SECRET=

# Seed credentials the API loads at boot (same values as E2E/AUTH test env).
AUTH_TEST_ADMIN_EMAIL=
AUTH_TEST_ADMIN_PASSWORD=
AUTH_TEST_USER_EMAIL=
AUTH_TEST_USER_PASSWORD=

# Public host Caddy serves (e.g. staging.example.com). Empty = serve on :80.
STAGING_DOMAIN=
